#!/usr/bin/env bash

if [ -z "$TMUX" ]; then
    fzf_bin="fzf"
else
    fzf_bin="fzf-tmux"
    fzf_opts="-p --border vertical"
fi

src=${HOME}/src

# Fuzzy find all git projects under ~/src
# ctrl-y: copy path to clipboard instead of opening session
next=$(list_git_projects | ${fzf_bin} ${fzf_opts} \
    --header="enter: open session | ctrl-y: copy path" \
    --expect=ctrl-y)
if [ -z "$next" ]; then
    exit 0
fi

key=$(echo "$next" | head -1)
next=$(echo "$next" | tail -1)
if [ -z "$next" ]; then
    exit 0
fi

dir=$src/$next

if [ "$key" = "ctrl-y" ]; then
    printf '%s' "$dir" | pbcopy
    [ -n "$TMUX" ] && tmux display-message "Copied: $dir"
    exit 0
fi

# Use the last 2 layer of the path as sessio name
session=${1:-$(basename $(dirname $next))/$(basename $next)}

# Escape . in path
session=$(echo $session | sed 's/\./_/g')

if [ -z "$TMUX" ]; then
    tmux a -t=$session || tmux new -s $session -c $dir
else
    tmux has-session -t="$session" || tmux new-session -s "$session" -d -c $dir 
    tmux switch-client -t="$session"
fi
